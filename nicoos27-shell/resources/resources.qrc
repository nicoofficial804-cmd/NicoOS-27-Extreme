        <file alias="bolt.svg">icons/system/bolt.svg</file>
        <file alias="brightness.svg">icons/system/brightness.svg</file>
        <file alias="calendar.svg">icons/system/calendar.svg</file>
        <file alias="camera.svg">icons/system/camera.svg</file>
        <file alias="check.svg">icons/system/check.svg</file>
        <file alias="chevron-down.svg">icons/system/chevron-down.svg</file>
