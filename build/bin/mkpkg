#!/usr/bin/env bash
#
# build/bin/mkpkg — costruisce un pacchetto pacman da un albero in stage.
#
# makepkg si rifiuta di girare come root e richiede fakeroot; nella sandbox
# non privilegiata non esiste un secondo uid reale. Questo strumento fa la
# parte di makepkg che serve qui, in modo deterministico:
#
#   stage/            albero già installato (prefisso /usr, DESTDIR)
#     -> .PKGINFO     metadati del pacchetto
#     -> .MTREE       inventario verificabile da pacman
#     -> .pkg.tar.zst archivio con proprietario root:root
#
# Il comando gira dentro `unshare --map-auto --map-root-user`: è ciò che
# permette di registrare i file come root:root senza essere root sull'host.
#
# Uso:
#   mkpkg --name N --version V --release R --stage DIR --out DIR
#         [--desc T] [--url U] [--license L] [--arch A]
#         [--depends P]... [--optdepends T]... [--provides P]...
set -euo pipefail

SELF_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
SELF=$SELF_DIR/$(basename -- "${BASH_SOURCE[0]}")
LIB_DIR=$(cd -- "$SELF_DIR/.." && pwd -P)/lib
# shellcheck source=../lib/common.sh
source "$LIB_DIR/common.sh"

orig_args=("$@")
if [[ ${NICOOS_MKPKG_INNER:-0} != 1 ]]; then
    if (( EUID != 0 )); then
        exec env NICOOS_MKPKG_INNER=1 \
            unshare --map-auto --map-root-user "$SELF" "${orig_args[@]}"
    fi
    export NICOOS_MKPKG_INNER=1
fi

usage() {
    cat <<'EOF'
uso: mkpkg --name N --version V --release R --stage DIR --out DIR
           [--desc TESTO] [--url URL] [--license L] [--arch A]
           [--depends PACCHETTO]... [--optdepends 'testo: descrizione']...
           [--provides NOME]...
EOF
}

name="" version="" release="" desc="" url="https://nicoos.dev"
license="MIT" arch="x86_64" stage="" out=""
depends=() optdepends=() provides=()

need_arg() {
    [[ $# -ge 2 && -n $2 ]] || die "opzione $1 senza valore (vedi mkpkg -h)"
}

while (( $# )); do
    case $1 in
        --name)       need_arg "$@"; name=$2; shift 2 ;;
        --version)    need_arg "$@"; version=$2; shift 2 ;;
        --release)    need_arg "$@"; release=$2; shift 2 ;;
        --desc)       need_arg "$@"; desc=$2; shift 2 ;;
        --url)        need_arg "$@"; url=$2; shift 2 ;;
        --license)    need_arg "$@"; license=$2; shift 2 ;;
        --arch)       need_arg "$@"; arch=$2; shift 2 ;;
        --stage)      need_arg "$@"; stage=$2; shift 2 ;;
        --out)        need_arg "$@"; out=$2; shift 2 ;;
        --depends)    need_arg "$@"; depends+=("$2"); shift 2 ;;
        --optdepends) need_arg "$@"; optdepends+=("$2"); shift 2 ;;
        --provides)   need_arg "$@"; provides+=("$2"); shift 2 ;;
        -h|--help)    usage; exit 0 ;;
        *)            die "argomento non riconosciuto: $1 (vedi mkpkg -h)" ;;
    esac
done

[[ -n $name && -n $version && -n $release && -n $stage && -n $out ]] || {
    usage >&2
    exit 1
}
[[ -d $stage ]] || die "albero in stage inesistente: $stage"
[[ -n $(ls -A -- "$stage" 2>/dev/null) ]] || die "albero in stage vuoto: $stage"

need_cmd() { have "$1" || die "comando richiesto non disponibile: $1"; }
need_cmd bsdtar
need_cmd zstd
need_cmd find

stage=$(realpath -P -- "$stage")
out=$(realpath -m -- "$out")
mkdir -p -- "$out"

work=$B/pkgtmp/${name}-${version}-${release}-${arch}
rm -rf -- "$work"
mkdir -p -- "$work"
cp -a -- "$stage/." "$work/"

# Proprietario root:root nell'archivio: dentro il namespace utente uid/gid 0
# sono quelli mappati, quindi il pacchetto è identico a uno di makepkg.
chown -R 0:0 -- "$work"

size=$(du -sb -- "$work" | cut -f1)
builddate=${SOURCE_DATE_EPOCH:-$(date +%s)}

{
    printf '# Generated by the NicoOS build (mkpkg)\n'
    printf 'pkgname = %s\n' "$name"
    printf 'pkgbase = %s\n' "$name"
    printf 'pkgver = %s-%s\n' "$version" "$release"
    printf 'pkgdesc = %s\n' "$desc"
    printf 'url = %s\n' "$url"
    printf 'builddate = %s\n' "$builddate"
    printf 'packager = NicoOS Build <build@nicoos.dev>\n'
    printf 'size = %s\n' "$size"
    printf 'arch = %s\n' "$arch"
    printf 'license = %s\n' "$license"
    for p in "${depends[@]}"; do printf 'depend = %s\n' "$p"; done
    for p in "${optdepends[@]}"; do printf 'optdepend = %s\n' "$p"; done
    for p in "${provides[@]}"; do printf 'provides = %s\n' "$p"; done
    printf 'xdata = pkgtype=pkg\n'
} > "$work/.PKGINFO"

# Inventario .MTREE come quello di makepkg: hash, permessi e proprietario di
# ogni file, così `pacman -Qkk` può verificarli dopo l'installazione.
(
    cd -- "$work"
    # --no-recursion: ogni percorso è già elencato (directory comprese).
    # Senza, bsdtar riaggiunge ricorsivamente il contenuto di ogni directory
    # e l'archivio contiene gli stessi file più volte.
    find . -mindepth 1 ! -name .MTREE ! -name .nicoos-filelist -printf '%P\0' \
        | sort -z > .nicoos-filelist
    bsdtar --format=mtree --no-recursion \
        --options='!all,use-set,type,uid,gid,mode,time,size,md5,sha256,link' \
        --null -T .nicoos-filelist -czf .MTREE
    rm -f -- .nicoos-filelist
)

pkgfile=$out/${name}-${version}-${release}-${arch}.pkg.tar.zst
rm -f -- "$pkgfile"

(
    cd -- "$work"
    mapfile -d '' entries < <(
        printf '.PKGINFO\0.MTREE\0'
        find . -mindepth 1 ! -name .PKGINFO ! -name .MTREE -printf '%P\0' | sort -z
    )
    bsdtar -cf - --format=pax --no-recursion -- "${entries[@]}" \
        | zstd -q -T0 -19 -c > "$pkgfile"
)

# Verifica minima ma reale: archivio leggibile, metadati interpretabili da
# pacman e contenuto non vuoto.
bsdtar -tf "$pkgfile" >/dev/null || die "archivio non leggibile: $pkgfile"
if have pacman; then
    pacman -Qip "$pkgfile" >/dev/null 2>&1 || \
        warn "pacman -Qip non ha accettato $pkgfile"
fi

info "creato $(basename -- "$pkgfile") ($(du -h -- "$pkgfile" | cut -f1))"
printf '%s\n' "$pkgfile"
