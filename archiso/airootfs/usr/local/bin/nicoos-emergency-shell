#!/bin/bash
# /usr/local/bin/nicoos-emergency-shell
#
# La Shell di emergenza di NicoOS. Viene mostrata quando Hyprland manca o non
# è riuscito ad avviarsi. Ha bisogno solo di una TTY e di una shell: niente
# Wayland, niente Qt, niente Hyprland.
#
# È raggiungibile in tre modi:
#   1. automaticamente: nicoos-session chiede a nicoos-emergency-console.path
#      di aprirla su una VT di testo (tty4) quando Hyprland manca o non parte,
#   2. manualmente:  sudo nicoos-emergency-shell
#   3. da qualsiasi TTY dopo un avvio grafico fallito (Ctrl+Alt+F2).
set -u

# La shell deve scrivere su un terminale *visibile*. SDDM avvia una sessione
# Wayland con la VT collegata solo a stdin: stdout è /dev/null e stderr finisce
# in ~/.local/share/sddm/wayland-session.log (UserSession.cpp, sddm 0.21). Il
# messaggio sarebbe quindi invisibile e zsh resterebbe in attesa su una VT che
# nessuno vede: il login sembrerebbe bloccato.
#
# /dev/tty è il terminale di controllo della sessione ed è sempre 0666, quindi
# si può riaprire anche come utente normale; /dev/tty0 resta come ripiego per
# root. Le redirezioni sono provate in una subshell così che una rifiutata non
# stampi nulla.
attach_terminal() {
    if [ -r /dev/tty ] && [ -w /dev/tty ] && { : </dev/tty >/dev/tty; } 2>/dev/null; then
        exec </dev/tty >/dev/tty 2>&1
        return 0
    fi
    if [ -t 0 ] || [ -t 1 ] || [ -t 2 ]; then
        return 0
    fi
    if [ -r /dev/tty0 ] && [ -w /dev/tty0 ] && { : </dev/tty0 >/dev/tty0; } 2>/dev/null; then
        exec </dev/tty0 >/dev/tty0 2>&1
        return 0
    fi
    return 1
}
attach_terminal || true

# Su una VT la definizione di terminale corretta è "linux"; zsh ne ha bisogno
# per il prompt e per le sequenze di escape di questa shell.
if [ -z "${TERM:-}" ] || [ "$TERM" = dumb ]; then
    case "$(tty 2>/dev/null || true)" in
        /dev/tty[0-9]*|/dev/console) export TERM=linux ;;
    esac
fi

# Rendi la console usabile e leggibile, qualunque sia lo stato del VT.
{
    printf '\033[0m\033[H\033[2J'
} 2>/dev/null || true

# ---------------------------------------------------------------------------
# Registrazione dei log
# ---------------------------------------------------------------------------
# /var/log/nicoos-emergency.log è il log globale. È di proprietà di root,
# quindi un utente normale non può accodarvi righe; scrivere lì non deve mai
# produrre un messaggio "Permesso negato" né interrompere la shell. La riga va
# nel log globale quando è possibile, altrimenti in un log per utente,
# altrimenti sulla console.
EMERGENCY_LOG="/var/log/nicoos-emergency.log"
if [ -n "${XDG_CACHE_HOME:-}" ]; then
    USER_LOG_DIR="$XDG_CACHE_HOME/nicoos"
elif [ -n "${HOME:-}" ]; then
    USER_LOG_DIR="$HOME/.cache/nicoos"
else
    USER_LOG_DIR="/tmp/nicoos-$(id -u)"
fi
USER_LOG="$USER_LOG_DIR/emergency.log"
SESSION_LOG="${XDG_RUNTIME_DIR:-/tmp}/nicoos/session.log"

log_to() {
    # log_to <file> <directory> <riga>
    # Crea il file se serve, poi accoda. Entrambe le scritture girano in una
    # subshell: una redirezione rifiutata viene segnalata da bash al momento
    # della preparazione, prima che 2>/dev/null sul comando abbia effetto, e
    # un /var/log non scrivibile non deve stampare proprio nulla.
    mkdir -p "$2" 2>/dev/null || return 1
    [ -e "$1" ] || { : >>"$1"; } 2>/dev/null || return 1
    [ -w "$1" ] || return 1
    { printf '%s\n' "$3" >>"$1"; } 2>/dev/null
}

nicoos_log() {
    line="$(date -Is) [emergency-shell] $*"
    if log_to "$EMERGENCY_LOG" /var/log "$line"; then
        return 0
    fi
    if log_to "$USER_LOG" "$USER_LOG_DIR" "$line"; then
        return 0
    fi
    printf '%s\n' "$line" >&2 2>/dev/null || true
}

cat <<'NICOOS_EMERGENCY'
Si è verificato un errore imprevisto durante l'avvio della GUI (Hyprland) e ora non puoi entrare nell'interfaccia.

Sei nella Shell di emergenza di NicoOS.
Se hai rimosso Hyprland per scherzo, assicurati di essere connesso a Internet ed esegui "sudo pacman -Sy hyprland"

Altrimenti, potrebbe essere la fine per te.

Non me ne frega niente, arrangiati.
NICOOS_EMERGENCY

# Il motivo concreto registrato da nicoos-session: senza, l'utente non sa se
# manca il pacchetto o se il compositore è andato in crash.
REASON_FILE="${HOME:-/tmp}/.cache/nicoos/last-failure"
if [ -r "$REASON_FILE" ]; then
    echo
    echo "Motivo registrato da nicoos-session:"
    head -n 1 "$REASON_FILE" 2>/dev/null | sed 's/^/  /'
    echo
fi

echo
echo "-------------------------------------------------------------------------"
echo " Utili:   sudo pacman -S hyprland sddm nicoos-shell"
echo "          systemctl status sddm     journalctl -b -u sddm"
echo "          log: $SESSION_LOG"
echo "               $EMERGENCY_LOG   $USER_LOG"
echo "-------------------------------------------------------------------------"
echo

# Registra che siamo finiti qui, per il debug successivo. Non fallisce mai,
# non stampa mai un errore di permessi: log globale se scrivibile, altrimenti
# il log dell'utente.
emergency_tty="$(tty 2>/dev/null || true)"
case "$emergency_tty" in
    /dev/*) ;;
    *) emergency_tty="?" ;;
esac
nicoos_log "accesso alla shell di emergenza (uid $(id -u), tty $emergency_tty)"

# Una shell di login interattiva e funzionante su questa TTY.
export PS1='nicoos-emergency:\w # '
if [ -x /usr/bin/zsh ]; then
    exec /usr/bin/zsh -i
elif [ -x /bin/bash ]; then
    exec /bin/bash -i
else
    exec /bin/sh -i
fi
