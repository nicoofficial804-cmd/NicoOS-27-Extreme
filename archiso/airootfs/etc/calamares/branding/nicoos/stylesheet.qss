/* /etc/calamares/branding/nicoos/stylesheet.qss
 *
 * Aspetto scuro "extreme" di NicoOS per l'interfaccia Calamares basata su
 * widget. Volutamente semplice: nessun gradiente, nessuna immagine per
 * singolo widget, così l'installer resta leggero su una VM live con
 * rendering software.
 */
/* Base scura per ogni widget dell'installer. Alcune pagine non disegnano il
 * proprio sfondo (e il contenitore della presentazione QML è un QQuickWidget
 * bianco): senza questa regola comparivano aree e diapositive bianche. Le
 * regole più specifiche qui sotto hanno comunque la precedenza. */
QWidget {
    background-color: #05070d;
    color: #dbe9f6;
}

#mainApp {
    background: #05070d;
}

QDialog, QMenu, QMenuBar, QToolBar, QStatusBar, QAbstractScrollArea {
    background-color: #080d16;
    color: #dbe9f6;
}

QMenu::item {
    padding: 5px 22px;
    background: transparent;
}

QMenu::item:selected {
    background: #0d2b3a;
    color: #00d9ff;
}

/* Etichette, caselle e schede lasciano trasparire lo sfondo della pagina. */
QLabel, QCheckBox, QRadioButton, QGroupBox, QTabWidget, QToolButton {
    background: transparent;
}

#sidebarApp {
    background: #080d16;
    border-right: 1px solid #14202e;
}

#sidebarApp QLabel {
    color: #5a6b80;
}

#logoApp {
    background: transparent;
}

QLabel {
    color: #dbe9f6;
}

QLabel#heading,
QLabel#title {
    color: #00d9ff;
    font-weight: bold;
}

QLineEdit, QPlainTextEdit, QTextEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background: #070c14;
    border: 1px solid #1b2b3d;
    border-radius: 6px;
    color: #e6f5ff;
    padding: 4px 8px;
    selection-background-color: #00d9ff;
    selection-color: #05070d;
}

QLineEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #00d9ff;
}

QPushButton {
    background: #0d1622;
    border: 1px solid #1b2b3d;
    border-radius: 6px;
    color: #e6f5ff;
    padding: 6px 14px;
}

QPushButton:hover {
    border: 1px solid #00d9ff;
    color: #00d9ff;
}

QPushButton:default {
    background: #00d9ff;
    color: #05070d;
    font-weight: bold;
}

QPushButton:disabled {
    color: #3f5064;
    border-color: #14202e;
}

QListView, QTreeView, QTableView {
    background: #070c14;
    border: 1px solid #1b2b3d;
    border-radius: 6px;
    color: #e6f5ff;
    alternate-background-color: #0a1220;
}

QListView::item:selected, QTreeView::item:selected {
    background: #0d2b3a;
    color: #00d9ff;
}

QGroupBox {
    border: 1px solid #1b2b3d;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    color: #00d9ff;
}

QProgressBar {
    background: #070c14;
    border: 1px solid #1b2b3d;
    border-radius: 6px;
    text-align: center;
    color: #e6f5ff;
}

QProgressBar::chunk {
    background: #00d9ff;
    border-radius: 5px;
}

QTabWidget::pane {
    border: 1px solid #1b2b3d;
}

QTabBar::tab {
    background: #0a1220;
    color: #8fa6bd;
    padding: 6px 14px;
}

QTabBar::tab:selected {
    background: #0d2b3a;
    color: #00d9ff;
}

QScrollBar:vertical {
    background: #05070d;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: #1b2b3d;
    border-radius: 5px;
}

QToolTip {
    background: #0b1220;
    color: #e6f5ff;
    border: 1px solid #00d9ff;
}
