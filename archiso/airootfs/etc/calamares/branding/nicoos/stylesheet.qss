/* /etc/calamares/branding/nicoos/stylesheet.qss
 *
 * Aspetto nero "extreme" di NicoOS per l'interfaccia Calamares basata su
 * widget: superfici nere e testo rosso NicoOS (#e3272b, lo stesso rosso del
 * logo ufficiale nicoos27extreme.png). Non resta alcun bianco di sfondo.
 * Volutamente semplice: nessun gradiente, nessuna immagine per singolo widget,
 * così l'installer resta leggero su una VM live con rendering software.
 */
/* Base nera per ogni widget dell'installer. Alcune pagine non disegnano il
 * proprio sfondo (e il contenitore della presentazione QML è un QQuickWidget):
 * senza questa regola comparivano aree con colori diversi. Le regole più
 * specifiche qui sotto hanno comunque la precedenza. */
QWidget {
    background-color: #000000;
    color: #e3272b;
}

#mainApp {
    background: #000000;
}

QDialog, QMenu, QMenuBar, QToolBar, QStatusBar, QAbstractScrollArea {
    background-color: #000000;
    color: #e3272b;
}

QMenu::item {
    padding: 5px 22px;
    background: transparent;
}

QMenu::item:selected {
    background: #e3272b;
    color: #000000;
}

/* Etichette, caselle e schede lasciano trasparire lo sfondo della pagina. */
QLabel, QCheckBox, QRadioButton, QGroupBox, QTabWidget, QToolButton {
    background: transparent;
}

#sidebarApp {
    background: #0a0a0a;
    border-right: 1px solid #2a0d0f;
}

#sidebarApp QLabel {
    color: #b41e22;
}

#logoApp {
    background: transparent;
}

QLabel {
    color: #e3272b;
}

QLabel#heading,
QLabel#title {
    color: #e3272b;
    font-weight: bold;
}

QLineEdit, QPlainTextEdit, QTextEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background: #121212;
    border: 1px solid #3a1215;
    border-radius: 6px;
    color: #e3272b;
    padding: 4px 8px;
    selection-background-color: #e3272b;
    selection-color: #000000;
}

QLineEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #e3272b;
}

QPushButton {
    background: #171717;
    border: 1px solid #3a1215;
    border-radius: 6px;
    color: #e3272b;
    padding: 6px 14px;
}

QPushButton:hover {
    border: 1px solid #e3272b;
    color: #ff6b6b;
}

QPushButton:default {
    background: #e3272b;
    border: 1px solid #e3272b;
    color: #000000;
    font-weight: bold;
}

QPushButton:default:hover {
    background: #c4161c;
    border-color: #c4161c;
    color: #000000;
}

QPushButton:disabled {
    color: #7a2a2d;
    border-color: #2a0d0f;
}

QListView, QTreeView, QTableView {
    background: #0a0a0a;
    border: 1px solid #3a1215;
    border-radius: 6px;
    color: #e3272b;
    alternate-background-color: #111111;
}

QListView::item:selected, QTreeView::item:selected {
    background: #e3272b;
    color: #000000;
}

QGroupBox {
    border: 1px solid #2a0d0f;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    color: #e3272b;
}

QProgressBar {
    background: #121212;
    border: 1px solid #2a0d0f;
    border-radius: 6px;
    text-align: center;
    color: #e3272b;
}

QProgressBar::chunk {
    background: #e3272b;
    border-radius: 5px;
}

QTabWidget::pane {
    border: 1px solid #2a0d0f;
}

QTabBar::tab {
    background: #111111;
    color: #b41e22;
    padding: 6px 14px;
}

QTabBar::tab:selected {
    background: #000000;
    color: #e3272b;
}

QScrollBar:vertical {
    background: #0a0a0a;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: #7a1a1e;
    border-radius: 5px;
}

QToolTip {
    background: #0a0a0a;
    color: #e3272b;
    border: 1px solid #e3272b;
}
