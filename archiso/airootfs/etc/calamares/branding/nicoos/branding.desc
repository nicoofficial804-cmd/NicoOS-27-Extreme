# /etc/calamares/branding/nicoos/branding.desc — NicoOS 27 Extreme
---
componentName: nicoos
slideshow: "show.qml"

welcomeStyleCalamares: false
welcomeExpandingLogo: true

windowExpanding: normal
windowSize: 1000px,640px
windowPlacement: center

sidebar: widget
navigation: widget

strings:
    productName:         "NicoOS 27 Extreme"
    shortProductName:    "NicoOS"
    version:             27
    shortVersion:        27
    versionedName:       "NicoOS 27 Extreme"
    shortVersionedName:  "NicoOS 27"
    bootloaderEntryName: "NicoOS"
    productUrl:          "https://nicoos.dev/"
    supportUrl:          "https://nicoos.dev/support"
    knownIssuesUrl:      "https://nicoos.dev/issues"
    releaseNotesUrl:     "https://nicoos.dev/releases/27"
    donateUrl:           ""

images:
    productIcon:    "logo.png"
    productLogo:    "logo.png"
    productWelcome: "wallpaper.png"

# Colori primari di NicoOS: il rosso del logo ufficiale (#e3272b) e il nero.
# La barra laterale è nera, la voce corrente è rossa con testo nero.
style:
    SidebarBackground:        "#000000"
    SidebarText:              "#e3272b"
    SidebarTextCurrent:       "#000000"
    SidebarBackgroundCurrent: "#e3272b"

# Presentazione QML (show.qml): sfondo nero opaco, titoli e testo rossi,
# così durante l'installazione non compaiono aree con colori estranei.
# È composta solo da rettangoli, un gradiente e testo: resta leggera anche con
# il rendering software delle macchine virtuali.
